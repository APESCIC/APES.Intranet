# Laragon local development (docs/local-development.md). Copy to .env.
# Values match docs/laragon/profile.json. scripts/laragon-setup.ps1 copies it.
# Fake local data only. No real HR, student, volunteer or agreement data.

APP_NAME="APES Intranet"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://apes-intranet.test

APP_LOCALE=en_GB
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laragon's MySQL 8.4. This project's own database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apes_intranet_local
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Mail is written to storage/logs/laravel.log, never sent.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@apes.org.uk"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=

LDAP_HOST=
LDAP_PORT=
LDAP_BASE_DN=
LDAP_GROUPS_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=
LDAP_GROUP_ATTRIBUTE=

AUDIT_LOG_RETENTION_DAYS=730
FRESH_SIGNIN_MINUTES=15

QA_LOGIN_ENABLED=true

COMMS_2FA_NUDGE_DISMISS_DAYS=14
COMMS_ENGAGE_URL=https://engage.cloud.microsoft/main/org/apescic.onmicrosoft.com/groups/apes
COMMS_SHAREPOINT_HOST=https://apescic.sharepoint.com/

# Geofence stays off until the DPIA approval date is set (docs/dpia/clock-in-geofence.md).
OPERATIONS_GEOFENCE_ENABLED=false
OPERATIONS_GEOFENCE_DPIA_APPROVED_AT=
OPERATIONS_GEOFENCE_RADIUS_METRES=250

CLOUDRON_PROFILE_URL=https://my.cloudron.apes.org.uk/#/profile
CLOUDRON_API_BASE=https://my.cloudron.apes.org.uk
CLOUDRON_API_TOKEN=
