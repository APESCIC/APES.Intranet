# Laragon on the owner's Windows machine. Copy to .env.
# Fake local data only. No real HR, student, volunteer or agreement data.

APP_NAME="APES Intranet"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://apes-intranet.test

APP_LOCALE=en_GB
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apes_intranet
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
CACHE_STORE=redis
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@apes.org.uk"
MAIL_FROM_NAME="${APP_NAME}"

VITE_DEV_SERVER_URL=http://localhost:5173

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=

LDAP_HOST=
LDAP_PORT=
LDAP_BASE_DN=
LDAP_GROUPS_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=
LDAP_GROUP_ATTRIBUTE=

QA_LOGIN_ENABLED=true
