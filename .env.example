# Cloudron / production. Leave every value blank.
# Cloudron supplies the runtime values. Do not commit a filled .env.

APP_NAME=
APP_ENV=
APP_KEY=
APP_DEBUG=
APP_URL=

APP_LOCALE=
APP_FALLBACK_LOCALE=
APP_FAKER_LOCALE=

APP_MAINTENANCE_DRIVER=

BCRYPT_ROUNDS=

LOG_CHANNEL=
LOG_STACK=
LOG_DEPRECATIONS_CHANNEL=
LOG_LEVEL=

DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=
SESSION_LIFETIME=
SESSION_ENCRYPT=
SESSION_PATH=
SESSION_DOMAIN=

BROADCAST_CONNECTION=
FILESYSTEM_DISK=
QUEUE_CONNECTION=
CACHE_STORE=

REDIS_CLIENT=
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=

MAIL_MAILER=
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

VITE_APP_NAME=
VITE_DEV_SERVER_URL=

# Web Push (VAPID). Generate once, store in the APES Vault, set on Cloudron in
# /app/data/shared/.env. Never commit real keys. Do not rotate casually —
# changing the public key invalidates every browser subscription.
VAPID_SUBJECT=mailto:intranet@apes.org.uk
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=

LDAP_HOST=
LDAP_PORT=
LDAP_BASE_DN=
LDAP_GROUPS_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=
LDAP_GROUP_ATTRIBUTE=

AUDIT_LOG_RETENTION_DAYS=

# HR retention in years (docs/dpia/hr-records.md). Blank uses the defaults in config/intranet.php.
HR_RETENTION_RECORD_YEARS_AFTER_LEAVE=
HR_RETENTION_DBS_YEARS_AFTER_LEAVE=
HR_RETENTION_RIGHT_TO_WORK_YEARS_AFTER_LEAVE=
HR_RETENTION_LEAVE_YEARS=
HR_RETENTION_APPRAISAL_YEARS_AFTER_LEAVE=
HR_RETENTION_TRAINING_YEARS_AFTER_LEAVE=
HR_RETENTION_CHECKLIST_YEARS_AFTER_LEAVE=
HR_RETENTION_RECOGNITION_YEARS_AFTER_LEAVE=

FRESH_SIGNIN_MINUTES=

QA_LOGIN_ENABLED=

COMMS_2FA_NUDGE_DISMISS_DAYS=
COMMS_ENGAGE_URL=
COMMS_SHAREPOINT_HOST=

# Geofence stays off until the DPIA approval date is set (docs/dpia/clock-in-geofence.md).
OPERATIONS_GEOFENCE_ENABLED=
OPERATIONS_GEOFENCE_DPIA_APPROVED_AT=
OPERATIONS_GEOFENCE_RADIUS_METRES=

CLOUDRON_PROFILE_URL=
CLOUDRON_API_BASE=
CLOUDRON_API_TOKEN=
